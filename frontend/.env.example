# "mock" runs the whole app against MSW with no backend. "live" calls the API.
NEXT_PUBLIC_API_MODE=mock

# Only read when NEXT_PUBLIC_API_MODE=live.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# The anonymous device session used until localStorage has one. Matches the
# backend seed device so live mode opens on the demo data.
NEXT_PUBLIC_DEFAULT_DEVICE_ID=demo-device

# The material the demo opens on, in both modes.
NEXT_PUBLIC_DEMO_MATERIAL_ID=mat_demo_js
