# "mock" runs the whole app against MSW with no backend. "live" calls the API.
NEXT_PUBLIC_API_MODE=mock

# Only read when NEXT_PUBLIC_API_MODE=live.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Prerender placeholder only, and never sent from a browser: each visitor mints
# their own device id on first load, so nobody shares an account.
NEXT_PUBLIC_DEFAULT_DEVICE_ID=demo-device

# The material the demo opens on. Mock mode only — in live mode this row is
# owned by the seed user, and no other device can read it.
NEXT_PUBLIC_DEMO_MATERIAL_ID=mat_demo_js
