{
  "name": "@educlm/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "contracts": "npm --prefix ../backend/packages/contracts install --no-package-lock --no-audit --no-fund && npx tsc -p ../backend/packages/contracts/tsconfig.json",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mocks:init": "msw init public --save",
    "fixtures": "node --experimental-strip-types scripts/generate-seed-fixture.ts",
    "mascot": "node --experimental-strip-types scripts/prepare-mascot.ts"
  },
  "dependencies": {
    "@educlm/contracts": "file:../backend/packages/contracts",
    "@radix-ui/react-dialog": "1.1.15",
    "@tanstack/react-query": "5.90.2",
    "clsx": "2.1.1",
    "next": "^15.5.22",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "msw": "2.11.2",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
