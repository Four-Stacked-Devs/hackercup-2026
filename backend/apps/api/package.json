{
  "name": "@educlm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:setup": "prisma migrate deploy && prisma db seed"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.23",
    "@ai-sdk/groq": "4.0.15",
    "@ai-sdk/openai": "4.0.22",
    "@educlm/contracts": "workspace:*",
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-pgvector": "0.0.5",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@huggingface/transformers": "4.2.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "ai": "7.0.40",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "fastify-type-provider-zod": "7.0.0",
    "p-queue": "9.3.3",
    "pg": "8.22.0",
    "pglite-prisma-adapter": "0.7.2",
    "unpdf": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
