{
  "name": "educlm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @educlm/api db:generate",
    "db:push": "pnpm --filter @educlm/api db:push",
    "db:migrate": "pnpm --filter @educlm/api db:migrate",
    "db:seed": "pnpm --filter @educlm/api db:seed",
    "db:setup": "pnpm --filter @educlm/api db:setup"
  },
  "devDependencies": {
    "turbo": "2.10.7",
    "typescript": "5.9.3"
  }
}
