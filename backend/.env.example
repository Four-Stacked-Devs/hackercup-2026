# ─────────────────────────────────────────────────────────────────────────────
# EducLM API  —  cp .env.example .env
#
# Every value below is OPTIONAL. With this file copied as-is and nothing filled
# in, `pnpm dev` boots on an embedded database with a deterministic stub model:
# no accounts, no API keys, no Docker, no cost.
#
# Fill in a section only when you want that real service. They are independent —
# you can add Groq without Supabase, or the other way round.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
CORS_ORIGIN=http://localhost:3000


# ═════════════════════════════════════════════════════════════════════════════
# 1. DATABASE — Supabase   (leave BOTH empty to use the embedded database)
# ═════════════════════════════════════════════════════════════════════════════
#
# Dashboard → "Connect" (top right) → ORMs tab → Prisma. It prints both.
#
# WHY TWO: pooled connections cannot run migrations. DATABASE_URL serves normal
# app queries; DIRECT_URL is used only by `prisma migrate` / `db push`, which
# issue DDL (CREATE TABLE, CREATE EXTENSION).
#
# SIMPLEST CORRECT SETUP for this project: copy the SESSION POOLER string
# (port 5432) into BOTH variables. Identical values is correct and expected.
# This API is a long-running server, not serverless, so session mode is the
# right fit — it runs DDL, needs no query parameters, and has no
# prepared-statement problems.
#
# Anatomy:
#   postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#                └──── user + project ref ──┘ └──────── pooler host ────────┘ └port┘
#
#   PASSWORD    = the DATABASE password from project creation, NOT your
#                 Supabase account password. Lost it? Project Settings →
#                 Database → Reset database password.
#   PROJECTREF  = the random string in your project URL.
#   Port is the ONLY difference between the options: 5432 session, 6543 transaction.
#
# Two traps:
#   1. Do NOT use the TRANSACTION pooler (6543) for DIRECT_URL. Transaction mode
#      cannot run DDL, so migrations fail.
#   2. Do NOT use db.PROJECT.supabase.co. That host is IPv6-only unless you pay
#      for the IPv4 add-on, so it times out on most home networks.
#
# Only when deploying to serverless (Vercel functions, edge) switch DATABASE_URL
# to port 6543 and append ?pgbouncer=true&connection_limit=1. DIRECT_URL stays 5432.
#
# Example (copy yours from the dashboard — do not use this verbatim):
#   DATABASE_URL="postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
#   DIRECT_URL="postgresql://postgres.abcdefgh:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

DATABASE_URL=
DIRECT_URL=

# Where the embedded database lives when DATABASE_URL is empty.
PGLITE_DIR=./.pglite


# ═════════════════════════════════════════════════════════════════════════════
# 2. LLM — Groq free tier   (leave LLM_API_KEY empty to use the stub)
# ═════════════════════════════════════════════════════════════════════════════
#
# console.groq.com → API Keys → Create API Key. Free, no card. Shown once.
# Without a key the pipeline still runs end to end, grounded in the document:
# topics from its headings, lessons from a structural reformat, questions from
# cloze extraction. The difference is polish, not whether it works.

LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile


# ═════════════════════════════════════════════════════════════════════════════
# 3. EMBEDDINGS — local, free, no key needed
# ═════════════════════════════════════════════════════════════════════════════
#
# Runs bge-small-en-v1.5 in-process via onnxruntime. The ~130MB model is
# downloaded once into EMBEDDING_CACHE_DIR, then works offline forever.
# Groq has no embeddings endpoint, which is why this is separate from the LLM.
#
# 384 dims is baked into the pgvector column by the migration. Changing the
# model to one with different dimensions requires a new migration.

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIMS=384
EMBEDDING_CACHE_DIR=./.models


# ═════════════════════════════════════════════════════════════════════════════
# 4. Uploads and limits
# ═════════════════════════════════════════════════════════════════════════════

STORAGE_DIR=./.uploads
MAX_UPLOAD_BYTES=20971520
LOG_LEVEL=info
RATE_LIMIT_MAX=120
